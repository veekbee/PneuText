  "info": {
    "title": "PneuText",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/imports/corpus": {
      "post": {
        "operationId": "importCorpus",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorpusImportIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorpusImportOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Import Corpus",
        "tags": [
          "corpus"
        ]
      }
    },
    "/api/imports/corpus/preview": {
      "post": {
        "description": "Read and check a folder of page files without writing anything.",
        "operationId": "previewCorpusImport",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorpusImportIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorpusImportPreviewOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Preview Corpus Import",
        "tags": [
          "corpus"
        ]
      }
    },
    "/api/library": {
      "get": {
        "operationId": "getLibrary",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Library Info",
        "tags": [
          "library"
        ]
      }
    },
    "/api/versions": {
      "get": {
        "operationId": "listVersions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/VersionSummaryOut"
                  },
                  "title": "Response Listversions",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Versions",
        "tags": [
          "corpus"
        ]
      }
    },
    "/api/versions/{version_id}": {
      "get": {
        "operationId": "getVersion",
        "parameters": [
          {
            "in": "path",
            "name": "version_id",
            "required": true,
            "schema": {
              "title": "Version Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Version",
        "tags": [
          "corpus"
        ]
      }
    },
    "/api/versions/{version_id}/pages/{page}/shape": {
      "get": {
        "description": "The shape projection of a page: line lengths and highlight positions, no text.",
        "operationId": "getPageShape",
        "parameters": [
          {
            "in": "path",
            "name": "version_id",
            "required": true,
            "schema": {
              "title": "Version Id",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "page",
            "required": true,
            "schema": {
              "title": "Page",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageShapeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Page Shape",
        "tags": [
          "corpus"
        ]
      }
    },
    "/api/versions/{version_id}/pages/{page}/text": {
      "get": {
        "description": "The text projection of a page. Blank mode never requests this.",
        "operationId": "getPageText",
        "parameters": [
          {
            "in": "path",
            "name": "version_id",
            "required": true,
            "schema": {
              "title": "Version Id",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "page",
            "required": true,
            "schema": {
              "title": "Page",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageTextOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Page Text",
        "tags": [
          "corpus"
        ]
      }
    }
  }
}
